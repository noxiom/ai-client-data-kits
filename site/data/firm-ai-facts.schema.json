    "incidents": {
      "title": "If client data goes into an AI tool by mistake",
      "oneOf": [
        {
          "const": "procedure",
          "title": "We have a procedure: record, assess, tell the client"
        },
        {
          "const": "no",
          "title": "No procedure yet"
