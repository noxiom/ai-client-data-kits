    "literacy": {
      "title": "Do staff know the rules and the tools' limits?",
      "description": "The AI Act's Article 4 asks firms that use AI systems to see to their staff's AI literacy.",
      "oneOf": [
        {
          "const": "trained",
          "title": "Briefed or trained, and kept up"
        },
        {
          "const": "planned",
          "title": "Planned"
        },
        {
          "const": "no",
          "title": "Not yet"
        }
      ]
    },
    "subprocessors": {
      "title": "Are the AI vendors on the sub-processor list you give clients?",
      "oneOf": [
        {
          "const": "yes",
          "title": "Yes"
        },
        {
          "const": "not_yet",
          "title": "Not yet"
        },
        {
          "const": "no_list",
          "title": "We don't keep a list"
        },
        {
          "const": "na",
          "title": "Not applicable: we are not a processor"
